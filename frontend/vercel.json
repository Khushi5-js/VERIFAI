{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RENDER-APP-NAME.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-RENDER-APP-NAME.onrender.com/uploads/:path*"
    }
  ]
}
